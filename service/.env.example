# Copy to service/.env (or .env in the directory you start Fire from).
# Variables already set in the shell win over this file.

# Where Fire listens. Open this address in a browser to use the web app.
FIRE_ADDR=127.0.0.1:8080

# Optional: a server-side App Store Connect key. Without one, each browser
# adds its own key and signs requests itself; the key never leaves the browser.
# With one, anyone who can reach Fire acts with this key, so Fire refuses to
# start on a non-loopback address unless FIRE_ALLOW_REMOTE_SERVER_KEY=true
# (only set that behind your own authentication).
# ASC_KEY_TYPE=team
# ASC_KEY_ID=ABCDE12345
# ASC_ISSUER_ID=69a6de70-03db-47e3-e053-5b8c7c11a4d1
# ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_ABCDE12345.p8
# For an individual key, set ASC_KEY_TYPE=individual and leave ASC_ISSUER_ID empty.
# FIRE_ALLOW_REMOTE_SERVER_KEY=false

# Extra browser origins allowed to call the API, comma separated
# (for example a web app served from another host). Same-origin always works.
# FIRE_ALLOWED_ORIGINS=https://fire.example.com

# Serve the web app from a folder instead of the copy built into the binary.
# FIRE_WEB_DIR=/absolute/path/to/service/internal/webui/dist

# Point Fire at another App Store Connect API base URL (for testing).
# ASC_BASE_URL=https://api.appstoreconnect.apple.com
