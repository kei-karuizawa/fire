# Copy to service/.env. The server loads that file on startup.
# A variable already set in the shell is left unchanged.
# The web UI is served by this process. Open http://127.0.0.1:8080.
FIRE_ADDR=127.0.0.1:8080
# Optional: let curl call the API without a browser-signed token.
# ASC_AUTH_MODE=local
# ASC_KEY_TYPE=team
# ASC_KEY_ID=YOUR_KEY_ID
# ASC_ISSUER_ID=YOUR_ISSUER_ID
# ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
# For individual keys, set ASC_KEY_TYPE=individual and omit ASC_ISSUER_ID.
