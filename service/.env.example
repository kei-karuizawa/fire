# Export these variables in your shell; .env files are not loaded automatically.
FIRE_ADDR=127.0.0.1:8080
FIRE_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ASC_AUTH_MODE=local
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
# For individual keys, set ASC_KEY_TYPE=individual and omit ASC_ISSUER_ID.
ASC_KEY_TYPE=team
# Optional: exact browser origin allowed to call this backend.
FIRE_ALLOWED_ORIGIN=http://localhost:3000
